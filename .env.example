PG_USER=aikit
PG_PASSWORD=aikit_local_only
PG_DB=aikit
PG_PORT=5436
PG_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_HOST=127.0.0.1

# ollama | openai（任何 OpenAI 相容端點：OpenAI、Gemini、vLLM、LM Studio、LiteLLM）
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama

OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3
EMBED_DIM=1024

OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
# 切雲端時一併改 CHAT_MODEL / EMBED_MODEL / EMBED_DIM，例如 gemini-flash-latest / gemini-embedding-001 / 768

CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
CACHE_TTL=3600
# 語意快取預設關閉：bge-m3 實測「3000 以下/以上誰核准」相似度 0.971，高於同義改寫 0.836，門檻擋不住
SEMANTIC_CACHE=off
SEMANTIC_CACHE_THRESHOLD=0.95
