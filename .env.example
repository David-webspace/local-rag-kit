PG_USER=aikit
PG_PASSWORD=aikit_local_only
PG_DB=aikit
PG_PORT=5436
PG_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_HOST=127.0.0.1

# ── 生成與 embedding 各自選 provider ──────────────────────────
# ollama = 本機 Ollama；openai = 下方 CLOUD_* 的 OpenAI 相容端點
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama
# 換 embedding 模型時 EMBED_DIM 一併改，啟動時會自動重建向量表（需重跑 ETL）
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ── 地端 ─────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_CHAT_MODEL=qwen3.5:9b

# ── 雲端（OpenAI 相容格式）── 各家寫法見 README「拿到 API key 之後」
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 留空時讀 shell 環境變數 GEMINI_API_KEY
CLOUD_API_KEY=
CLOUD_CHAT_MODEL=gemini-flash-latest
# bearer（預設）或 api-key（Azure OpenAI）
CLOUD_AUTH=bearer
# Azure OpenAI 才需要，例如 2024-10-21
CLOUD_API_VERSION=
# embedding 走不同端點或 key 時才填（例如 Azure 的另一個 deployment），留空沿用上面
CLOUD_EMBED_BASE_URL=
CLOUD_EMBED_API_KEY=

# ── Agent ────────────────────────────────────────────────────
AGENT_MAX_STEPS=6

# ── RAG ──────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
CACHE_TTL=3600
# 語意快取預設關閉：bge-m3 實測「3000 以下/以上誰核准」相似度 0.971，高於同義改寫 0.836，門檻擋不住
SEMANTIC_CACHE=off
SEMANTIC_CACHE_THRESHOLD=0.95
